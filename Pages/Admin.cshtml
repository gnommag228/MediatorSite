@page
@model MediatorSite.Pages.AdminModel
@{
    ViewData["Title"] = "Панель администратора";
}

<div class="container mt-4">
    @if (!Model.IsAuthenticated)
    {
        <!-- Форма входа -->
    <div class="row justify-content-center">
        <div class="col-md-4 card p-4 shadow-sm mt-5">
            <h3 class="text-center mb-3">Вход для админа</h3>
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Введите пароль</label>
                    <input type="password" name="password" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Войти</button>
            </form>
        </div>
    </div>
    }
    else
    {
 <!-- Защищенная таблица -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Заявки на консультацию</h2>
        <form method="post" asp-page-handler="Logout">
            <button class="btn btn-outline-danger btn-sm">Выйти</button>
        </form>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Имя</th>
                <th>Телефон</th>
                <th>Дата встречи</th>
                <th>Комментарий</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Bookings)
                {
            <tr>
                <td>@item.BookingId</td>
                <td>@item.CustomerName</td>
                <td>@item.Phone</td>
                <td>@item.BookingDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.SpecialRequests</td>
                <td>
                    <!-- Выпадающий список для быстрой смены статуса -->
                    <form method="post" asp-page-handler="UpdateStatus" class="d-flex gap-1">
                        <input type="hidden" name="id" value="@item.BookingId" />
                        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="Новая" selected="@(item.Status == "Новая")">Новая</option>
                            <option value="В работе" selected="@(item.Status == "В работе")">В работе</option>
                            <option value="Завершена" selected="@(item.Status == "Завершена")">Завершена</option>
                        </select>
                    </form>
                </td>
                <td>
                    <!-- Кнопка удаления -->
                    <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Удалить эту заявку?');">
                        <input type="hidden" name="id" value="@item.BookingId" />
                        <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                    </form>
                </td>
            </tr>
                }
        </tbody>
    </table>
    }
</div>