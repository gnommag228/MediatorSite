@page
@model IndexModel
@{
    ViewData["Title"] = "Центр медиации и психологической помощи";
}
<!-- Главный баннер (Hero) -->
<section class="py-5 mb-5 rounded-5 bg-white border border-1 shadow-sm text-center" style="min-height: 380px; display: flex; align-items: center;">
    <div class="container py-3">
        <div class="mx-auto" style="max-width: 750px;">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill fw-medium">
                <i class="bi bi-shield-check me-1"></i> Конфиденциально & Профессионально
            </span>

            <h1 class="display-4 fw-bold mb-3 text-dark" style="letter-spacing: -0.5px;">Когда договориться самим уже не получается</h1>

            <p class="fs-5 text-muted mb-4 fw-normal" style="line-height: 1.6;">
                Без суда: медиация помогает договориться о деньгах, детях, имуществе и других спорных вопросах — с участием нейтрального посредника.
            </p>

            <a href="#booking-form" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-sm fw-medium">
                Обсудить мою ситуацию <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>
<!-- Блок "О специалисте" -->
<section id="about" class="mb-5">
    <div class="row align-items-center g-4">
        <div class="col-md-5">
            <img src="/images/specialist.jpg" alt="Медиатор Юлия" class="img-fluid rounded-4 shadow object-fit-cover" style="max-height: 650px; width: 100%;">

        </div>
        <div class="col-md-7">
            <h2 class="fw-bold mb-3">Ваш медиатор — Юлия Владимировна</h2>
            <p class="text-muted fs-5">Дипломированный медиатор. Работаю с семейными, деловыми и наследственными спорами. Организую переговоры так, чтобы вы нашли решение, которое устроит всех.</p>
            <ul class="list-unstyled mb-4">
                <li class="mb-2">✔️ Быстрее, дешевле и безопаснее, чем суд</li>
                <li class="mb-2">✔️ Никакой огласки: ваша ситуация останется только между участниками</li>
                <li class="mb-2">✔️ Организую переговоры так, чтобы каждый мог высказаться и быть услышанным</li>
                <li class="mb-2">✔️ Помогаю сторонам перейти от спора к обсуждению решений</li>
                <li class="mb-2">✔️ Фиксирую договоренности в медиативном соглашении (при нотариальном удостоверении   имеет силу исполнительного документа)</li>
            </ul>
        </div>
    </div>
</section>

<!-- Карточки услуг (без картинок, с иконками) -->
<section id="services" class="mb-5">
    <h2 class="text-center fw-bold mb-4">Форматы работы</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="mb-3 text-primary fs-1">
                    <i class="bi bi-person-heart"></i>
                </div>
                <div class="card-body p-0">
                    <h5 class="card-title fw-bold mb-2">Конфликтологическое консультирование</h5>
                    <p class="card-text text-muted small mb-3">Первичная консультация для одного участника. Разбираем ситуацию, определяем суть спора и дальнейшие шаги. При необходимости связываюсь со второй стороной и приглашаю к диалогу.</p>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">60 минут · онлайн или лично</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="mb-3 text-primary fs-1">
                    <i class="bi bi-people"></i>
                </div>
                <div class="card-body p-0">
                    <h5 class="card-title fw-bold mb-2">Медиация</h5>
                    <p class="card-text text-muted small mb-3">Совместная встреча. Я, как нейтральный посредник, помогаю перейти от спора к поиску решений.</p>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">120 минут · онлайн или лично</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">
                <div class="mb-3 text-primary fs-1">
                    <i class="bi bi-laptop"></i>
                </div>
                <div class="card-body p-0">
                    <h5 class="card-title fw-bold mb-2">Онлайн-формат</h5>
                    <p class="card-text text-muted small mb-3">Консультация или медиация — удаленно. Удобно, если вы в другом городе или предпочитаете онлайн. Zoom, Telegram, WhatsApp.</p>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">60–120 минут</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Форма бронирования -->
<section id="booking-form" class="py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <h3 class="fw-bold text-center mb-2">Обсудить мою ситуацию</h3>
                   <p class="text-center text-muted mb-4">Заполните форму — я свяжусь с вами, чтобы уточнить детали и подтвердить встречу. Конфиденциально.</p>



                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ваше имя</label>
                        <input asp-for="Booking.CustomerName" class="form-control form-control-lg" placeholder="Иван Иванов" required />
                        <span asp-validation-for="Booking.CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Booking.Phone" class="form-label fw-medium">Номер телефона</label>
                        <input asp-for="Booking.Phone"
                               id="phone-input"
                               type="tel"
                               class="form-control form-control-lg rounded-3"
                               placeholder="+7 (999) 000-00-00"
                               autocomplete="off"
                               required />
                        <span asp-validation-for="Booking.Phone" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Дата встречи</label>
                            <input type="date" name="SelectedDate" class="form-control form-control-lg" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Время встречи</label>

                            <!-- Скрытое поле для отправки значения на бэкенд -->
                            <input type="hidden" name="SelectedTime" id="selected-time-input" required />

                            <!-- Контейнер для кликабельных кнопок -->
                            <div id="time-slots-container" class="d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Тема обращения / Комментарий</label>
                        <textarea asp-for="Booking.SpecialRequests" class="form-control" rows="3" placeholder="Кратко опишите суть вашего вопроса..."></textarea>
                    </div>

                    <button type="submit" id="submit-btn" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold">
                        Записаться
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Вопросы и ответы (FAQ) -->
<section id="faq" class="mt-5 mb-4">
    <h2 class="text-center fw-bold mb-4">Часто задаваемые вопросы</h2>
    <div class="accordion shadow-sm rounded-4 overflow-hidden" id="faqAccordion">

        <!-- Вопрос 1 -->
        <div class="accordion-item border-0">
            <h2 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                    Как проходит первая встреча?
                </button>
            </h2>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    На первой сессии мы формулируем ваш запрос, обсуждаем ожидаемые результаты и составляем комфортный план дальнейшей работы.
                </div>
            </div>
        </div>

        <!-- Вопрос 2 -->
        <div class="accordion-item border-0 border-top">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                    Эффективна ли онлайн-консультация так же, как личная встреча?
                </button>
            </h2>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    Да, результат сессии не зависит от формата. Главное — находиться в спокойном и безопасном месте, где вас никто не будет отвлекать во время созвона.
                </div>
            </div>
        </div>

        <!-- Вопрос 3 -->
        <div class="accordion-item border-0 border-top">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                    Нужно ли как-то специально готовиться к сессии?
                </button>
            </h2>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    Специальная подготовка не требуется. Достаточно сформулировать ключевые темы или вопросы, которые вы хотите обсудить в первую очередь.
                </div>
            </div>
        </div>

        <!-- Вопрос 4 -->
        <div class="accordion-item border-0 border-top">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                    Что делать, если нужно отменить или перенести запись?
                </button>
            </h2>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    Вы можете перенести или отменить консультацию, предупредив меня в Telegram или WhatsApp не позднее чем за 24 часа до назначенного времени.
                </div>
            </div>
        </div>

        <!-- Вопрос 5 -->
        <div class="accordion-item border-0 border-top">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                    Гарантируется ли конфиденциальность?
                </button>
            </h2>
            <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-muted">
                    Абсолютно. Вся информация, озвученная на консультациях или медиациях, строго конфиденциальна и не передается третьим лицам.
                </div>
            </div>
        </div>

    </div>
</section>

