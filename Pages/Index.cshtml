@page
@model IndexModel
@{
    ViewData["Title"] = "Центр медиации и психологической помощи";
}

<style>
    :root {
        --primary-blue: #3B6EA5;
        --bg-beige: #F5F0E8;
    }

    /* Настройка шрифтов */
    h1, h2, h3, h4, .font-heading {
        font-family: 'Manrope', 'Golos Text', system-ui, -apple-system, sans-serif !important;
    }

    /* Переопределение цветов Bootstrap на фирменные */
    .btn-primary, .bg-primary {
        background-color: var(--primary-blue) !important;
        border-color: var(--primary-blue) !important;
    }

    .text-primary {
        color: var(--primary-blue) !important;
    }

    .btn-outline-primary {
        color: var(--primary-blue) !important;
        border-color: var(--primary-blue) !important;
    }

        .btn-outline-primary:hover {
            background-color: var(--primary-blue) !important;
            color: #fff !important;
        }

    /* Мягкие тени для кнопок */
    .btn-primary {
        box-shadow: 0 4px 12px rgba(59, 110, 165, 0.25) !important;
        transition: all 0.2s ease-in-out;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(59, 110, 165, 0.35) !important;
        }

    .bg-beige-block {
        background-color: var(--bg-beige) !important;
    }
</style>

<section class="py-5 mb-5 rounded-5 bg-white border border-1 shadow-sm text-center" style="min-height: 380px; display: flex; align-items: center;">
    <div class="container py-3">
        <div class="mx-auto" style="max-width: 750px;">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill fw-medium">
                <i class="bi bi-shield-check me-1"></i> Конфиденциально & Профессионально
            </span>

            <h1 class="display-4 fw-bold mb-3 text-dark" style="letter-spacing: -0.5px;">Когда договориться самим уже не получается</h1>

            <p class="fs-5 text-muted mb-4 fw-normal" style="line-height: 1.6;">
                Без суда: медиация помогает договориться о деньгах, детях, имуществе и других спорных вопросах — с участием нейтрального посредника.
            </p>

            <a href="#booking-form" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-sm fw-medium">
                Обсудить мою ситуацию <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<section id="about" class="mb-5 p-4 p-md-5 rounded-5 bg-beige-block">
    <div class="row align-items-center g-4">
        <div class="col-md-5">
            <img src="/images/specialist2.jpg" alt="Медиатор Юлия" class="img-fluid rounded-4 shadow object-fit-cover" style="max-height: 650px; width: 100%;">
        </div>
        <div class="col-md-7">
            <h2 class="fw-bold mb-3">Ваш медиатор — Юлия Владимировна</h2>
            <p class="text-muted fs-5">Дипломированный медиатор. Работаю с семейными, деловыми и наследственными спорами. Организую переговоры так, чтобы вы нашли решение, которое устроит всех.</p>
            <ul class="list-unstyled mb-4">
                <li class="mb-2">✔️ Быстрее, дешевле и безопаснее, чем суд</li>
                <li class="mb-2">✔️ Никакой огласки: ваша ситуация останется только между участниками</li>
                <li class="mb-2">✔️ Организую переговоры так, чтобы каждый мог высказаться и быть услышанным</li>
                <li class="mb-2">✔️ Помогаю сторонам перейти от спора к обсуждению решений</li>
                <li class="mb-2">✔️ Фиксирую договоренности в медиативном соглашении (при нотариальном удостоверении имеет силу исполнительного документа)</li>
            </ul>
        </div>
    </div>
</section>

